# ==============================================================================
# ReadyCity Environment Configuration Template
# Copy this file to .env and populate with your environment-specific credentials.
# ==============================================================================

# TiDB Cloud / MySQL Database Configuration
TIDB_HOST=your-cluster-name.region.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_tidb_username.root
TIDB_PASS=your_tidb_password_here
TIDB_NAME=readycity_db

# Security & Authentication
# Secret key used for signing and verifying Admin JWT tokens
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key
